{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "schematics": {
        "@ionic/angular-toolkit:page": {
          "styleext": "scss",
          "standalone": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "www",
              "browser": ""
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "sql-wasm*.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets/sql.js"
              }
            ],
            "styles": [
              "src/global.scss",
              "src/theme/variables.scss",
              "src/theme/form-modal.scss",
              "src/theme/form-field.scss",
              "src/theme/segment-control.scss",
              "src/theme/list-card.scss",
              "src/theme/button-row.scss",
              "src/theme/header-elevation.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "sql.js"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "12kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/environments/groq-development.ts",
                  "with": "src/environments/groq.ts"
                },
                {
                  "replace": "src/app/features/dashboard/dashboard.routes.ts",
                  "with": "src/app/features/dashboard/dashboard.leptos.routes.ts"
                },
                {
                  "replace": "src/app/onboarding-entry.ts",
                  "with": "src/app/features/onboarding/leptos/onboarding.page.ts"
                },
                {
                  "replace": "src/app/account-entry.ts",
                  "with": "src/app/features/account/leptos/entry.ts"
                },
                {
                  "replace": "src/app/features/calendar/calendar.routes.ts",
                  "with": "src/app/features/calendar/leptos/calendar.routes.ts"
                },
                {
                  "replace": "src/app/features/management/management.routes.ts",
                  "with": "src/app/features/management/leptos/management.routes.ts"
                },
                {
                  "replace": "src/app/features/settings/settings.routes.ts",
                  "with": "src/app/features/settings/leptos/settings.routes.ts"
                },
                {
                  "replace": "src/app/features/fitness/fitness.routes.ts",
                  "with": "src/app/features/fitness/leptos/fitness.routes.ts"
                }
              ],
              "outputHashing": "all",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "src/assets",
                  "output": "assets"
                },
                {
                  "glob": "sql-wasm*.wasm",
                  "input": "node_modules/sql.js/dist",
                  "output": "assets/sql.js"
                },
                {
                  "glob": "healthmate_dashboard*.js",
                  "input": "target/leptos-web",
                  "output": "assets/leptos"
                },
                {
                  "glob": "healthmate_dashboard*.wasm",
                  "input": "target/leptos-web",
                  "output": "assets/leptos"
                }
              ]
            },
            "leptos": {},
            "angular-reference": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "src/assets",
                  "output": "assets"
                },
                {
                  "glob": "sql-wasm*.wasm",
                  "input": "node_modules/sql.js/dist",
                  "output": "assets/sql.js"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/environments/groq-development.ts",
                  "with": "src/environments/groq.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "ci": {
              "progress": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            },
            "ci": {
              "progress": false
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "sql-wasm*.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets/sql.js"
              }
            ],
            "styles": [
              "src/global.scss",
              "src/theme/variables.scss",
              "src/theme/form-modal.scss",
              "src/theme/form-field.scss",
              "src/theme/segment-control.scss",
              "src/theme/list-card.scss",
              "src/theme/button-row.scss",
              "src/theme/header-elevation.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "leptos-parity": {
              "assets": [
                { "glob": "**/*", "input": "src/assets", "output": "assets" },
                { "glob": "sql-wasm*.wasm", "input": "node_modules/sql.js/dist", "output": "assets/sql.js" },
                { "glob": "*.js", "input": "target/leptos-web", "output": "assets/leptos" },
                { "glob": "*.wasm", "input": "target/leptos-web", "output": "assets/leptos" }
              ]
            },
            "ci": {
              "progress": false,
              "watch": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@ionic/angular-toolkit"
    ],
    "analytics": false
  },
  "schematics": {
    "@ionic/angular-toolkit:component": {
      "styleext": "scss"
    },
    "@ionic/angular-toolkit:page": {
      "styleext": "scss"
    },
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    }
  }
}
